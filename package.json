{
    "name": "claude-village",
    "version": "0.1.0",
    "description": "A 2D top-down RPG world where Claude Code subagents are NPCs you can chat with.",
    "module": "server.ts",
    "type": "module",
    "bin": {
        "claude-village": "./server.ts"
    },
    "files": [
        "server.ts",
        "public",
        "subagents",
        "skills",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "start": "bun run --watch server.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "latest",
        "eslint": "^10.4.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.59.4"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.145",
        "hono": "^4.12.19"
    }
}
