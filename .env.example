# Recommended: long-lived OAuth token from `claude setup-token`.
# Draws on your Pro/Max plan's Agent SDK credit and never race-refreshes your
# interactive Claude Code session. Can also live in ~/.config/claude-village/token
CLAUDE_VILLAGE_TOKEN=sk-ant-oat-your-token-here

# Legacy alternative: pay-as-you-go API credits. Ignored when a token is set.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
